#include <stdio.h>
int subarraySum(int arr[], int n, int k) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        int sum = 0;
        for (int j = i; j < n; j++) {
            sum += arr[j]; 
            if (sum == k)
                count++; }
    }
    return count;
}
int main() {
    int arr[] = {1, 2, 3};
    int k = 3;
    int n = sizeof(arr) / sizeof(arr[0]);

    int result = subarraySum(arr, n, k);
    printf("Number of subarrays with sum %d: %d\n", k, result);
    return 0;
}
